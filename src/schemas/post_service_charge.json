{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "amount"],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})\\.[0-9]{2}$"
    }
  }
}