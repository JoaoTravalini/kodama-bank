{
  "title": "PostLogin",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "maxLength": 255,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": ["email", "password"],
  "additionalProperties": false
}